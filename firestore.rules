// Firestore security rules: SleepLab
//
// What this allows (and nothing else):
//   The owner, signed in with email/password, under /users/{their uid}:
//     profile/main, settings/main                read, create, update
//     nights/{YYYY-MM-DD}                        read, create, update
//     nights/{YYYY-MM-DD}/awakenings/{1-99}      read, create, update, delete
//     dailyFactors/{YYYY-MM-DD}                  read, create, update
//
// What this blocks:
//   - All unauthenticated access, reads and writes both.
//   - Any other signed-in account, even inside its own /users/{uid} subtree. Sign-up is off in
//     the console, so no other account should exist; pinning the owner's UID keeps the data closed
//     even if one does.
//   - Any path not listed above, even for the owner.
//   - Deleting the profile, settings, a night or a day's factors. The app never deletes them
//     (there is no delete-all in v1); a manual deletion goes through the Firebase CLI, which
//     bypasses these rules. Only a single detailed awakening can be removed, when a night is edited.
//
// Deployed with
//   firebase deploy --only firestore:rules
// after tests/rules-test.py passes against the emulator.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && request.auth.uid == 'C2RLiFz779MQknhdAQfNWa6sIIB3';
    }
    function isDate(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /users/{userId} {

      match /profile/{docId} {
        allow get: if isOwner(userId) && docId == 'main';
        allow create, update: if isOwner(userId) && docId == 'main';
      }

      match /settings/{docId} {
        allow get: if isOwner(userId) && docId == 'main';
        allow create, update: if isOwner(userId) && docId == 'main';
      }

      match /nights/{nightDate} {
        allow get: if isOwner(userId) && isDate(nightDate);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isDate(nightDate);

        match /awakenings/{n} {
          allow get, delete: if isOwner(userId) && n.matches('^[1-9][0-9]?$');
          allow list: if isOwner(userId);
          allow create, update: if isOwner(userId) && n.matches('^[1-9][0-9]?$');
        }
      }

      match /dailyFactors/{nightDate} {
        allow get: if isOwner(userId) && isDate(nightDate);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isDate(nightDate);
      }
    }

    // Documentation only: Firestore already denies any path with no matching allow, and rules are a
    // union across matching blocks, so this can't take back access granted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
